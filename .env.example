# QuotaMesh provider API keys (template).
# Copy to .env and fill in only the keys you own. .env is git-ignored; never commit real keys.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash/zsh:    cp .env.example .env
#
# Import into a running QuotaMesh (you choose each key's plan during the preview):
#   quotamesh import-env --file .env
#
# Several keys for one provider use numbered names, e.g. GEMINI_API_KEY_2.
# Keys from the same provider project share one quota; give keys from different
# projects distinct quota groups in the dashboard so one rate limit does not pause both.

OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional providers:
# GOOGLE_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here

# Optional overrides for the opt-in live test suite (docs/live-testing.md):
# QM_LIVE_OPENAI_MODEL=gpt-4.1-nano
# QM_LIVE_GEMINI_MODEL=gemini-2.5-flash-lite
